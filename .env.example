# Copy to .env and fill in what you need. Only the "Required" block is needed to start.
# Identity, timezone, pay and shift locations live in src/config/, not here.

# ===== Required =====
# Session encryption key. Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-output-of-openssl-rand-base64-32
# Postgres password used by docker compose
DB_PASSWORD=dashboard

# ===== Try it locally =====
# DEMO_MODE skips Google sign-in. Never enable it on an instance reachable from the internet.
DEMO_MODE=true
# Load invented demo data into an empty database on first start
SEED_DEMO_DATA=true

# ===== Real use: Google sign-in =====
# Create an OAuth client at console.cloud.google.com (APIs and Services, Credentials).
# Authorized redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google accounts allowed to sign in, comma separated
ALLOWED_EMAILS=you@example.com
GOOGLE_CALENDAR_ID=primary

# Public URL used in emails and share links (defaults to NEXTAUTH_URL)
APP_URL=
# Contact address shown on the /privacy page
PRIVACY_CONTACT_EMAIL=

# ===== Optional: media =====
# Base URL for public share links, if you serve them from a separate domain
CDN_BASE_URL=
MEDIA_STORAGE_LIMIT_GB=10

# ===== Optional: AI chat and diary summaries =====
ANTHROPIC_API_KEY=
# Admin key (sk-ant-admin-...) for the Claude usage and cost page
ANTHROPIC_ADMIN_KEY=

# ===== Optional: email (share links, weekly summary, backup notices) =====
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=
SMTP_FROM_EMAIL=
# Recipient for the weekly summary and backup emails
SUMMARY_EMAIL_TO=

# ===== Optional: push notifications =====
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ===== Optional: cron endpoint tokens =====
# Each endpoint stays disabled until its token is set. Generate with: openssl rand -hex 16
# The cron service in docker compose calls the sites and push endpoints every minute.
SITES_CRON_SECRET=
PUSH_CRON_SECRET=
BACKUP_CRON_SECRET=
SUMMARY_CRON_SECRET=

# ===== Optional: Google Sheets and Drive backups =====
SHEETS_SYNC_SPREADSHEET_ID=
SHEETS_SYNC_SECRET=
# Leave empty to let the app create a "Dashboard Backups" folder in your Drive
DRIVE_BACKUP_FOLDER_ID=
ENABLE_DRIVE_AUTO_BACKUP=false

# ===== Local development without Docker (pnpm dev) =====
# DATABASE_URL=postgresql://dashboard:devpassword@localhost:5432/dashboard
# APP_PORT=3000
